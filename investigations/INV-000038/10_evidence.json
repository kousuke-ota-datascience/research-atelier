    },
    {
      "evidence_id": "E0013",
      "content": "Gebraeelら（2005）は部品の劣化信号からBayesianアプローチによって残存寿命の分布を推定する枠組みを研究した。",
      "source_locator": "IIE Transactions bibliographic abstract",
      "note_type": "Method",
      "selection_reason": "Original data generation, Bayesian RUL, gamma deterioration and deep prognostics methods supporting a more representative methodological review.",
      "provenance": {

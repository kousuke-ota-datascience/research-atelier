        }
      }
    },
    {
      "evidence_id": "E0007",
      "content": "Nagpalら（2021）のDeep Survival Machinesはcensoringとcompeting risksのあるtime-to-event予測を深層survival回帰で扱う。元の検証領域は医療である。",
      "source_locator": "PubMed Abstract",
      "note_type": "Method",
      "selection_reason": "Representative definition, methodological family, benchmark constraint or uncertainty in approved prognostics scope",
      "provenance": {
        "source_id": "SRC-000190",

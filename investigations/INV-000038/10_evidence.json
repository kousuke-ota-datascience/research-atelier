  "evidence_items": [
    {
      "evidence_id": "E0001",
      "content": "Jardineら（2006）はCBMをdata acquisition、processing、maintenance decision-makingに分け、diagnosticsを現在の故障の検知・分離・同定、prognosticsを将来の故障の予測と区別する。",
      "source_locator": "Review: Introduction and Abstract",
      "note_type": "Definition",
      "selection_reason": "Representative definition, methodological family, benchmark constraint or uncertainty in approved prognostics scope",
      "provenance": {
        "source_id": "SRC-000184",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/40fe5855be398164ab55f431a37f79c9",
          "title": "EV-000306"
        }
      }
    },
    {
      "evidence_id": "E0002",
      "content": "Siら（2011）はRULを時点での残余使用可能期間として確率的に捉え、直接観測される状態情報の有無に基づいて統計手法を分類する。",
      "source_locator": "Review: Abstract and Introduction",
      "note_type": "Definition",
      "selection_reason": "Representative definition, methodological family, benchmark constraint or uncertainty in approved prognostics scope",
      "provenance": {
        "source_id": "SRC-000185",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/40fe5855be3981298bc0eaa229bcb5d6"
        }
      }
    },
    {
      "evidence_id": "E0003",
      "content": "ISO 13381-1:2025公式要旨は、prognostics開発・適用の要件、必要なデータ・プロセス・特性の共通理解と指針を対象にすると説明する。",
      "source_locator": "ISO official abstract (not full standard)",
      "note_type": "Definition",
      "selection_reason": "Representative definition, methodological family, benchmark constraint or uncertainty in approved prognostics scope",
      "provenance": {
        "source_id": "SRC-000186",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/40fe5855be39819ead62e6ced28020dc",
          "title": "EV-000308"
        }
      }
    },
    {
      "evidence_id": "E0004",
      "content": "NASA PCoEはC-MAPSSターボファン劣化simulationに、異なる運転条件・故障モードの組合せで4セットがあり、複数センサチャネルで劣化過程を記録したと説明する。",
      "source_locator": "NASA PCoE Turbofan Engine Degradation Simulation",
      "note_type": "Data",
      "selection_reason": "Representative definition, methodological family, benchmark constraint or uncertainty in approved prognostics scope",
      "provenance": {
        "source_id": "SRC-000187",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/40fe5855be3981de8346cb3b10255558",
          "title": "EV-000309"
        }
      }
    },
    {
      "evidence_id": "E0005",
      "content": "Liら（2018）はCNNに基づくRUL回帰手法を提案し、NASA C-MAPSS航空エンジン劣化データを用いて評価した。",
      "source_locator": "Article highlights",
      "note_type": "Method",
      "selection_reason": "Representative definition, methodological family, benchmark constraint or uncertainty in approved prognostics scope",
      "provenance": {
        "source_id": "SRC-000188",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/40fe5855be3981178396f62999dbf8e6",
          "title": "EV-000310"
        }
      }
    },
    {
      "evidence_id": "E0006",
      "content": "Zhengら（2017）はセンサ系列の順序情報を活かすLSTMによるRUL推定を研究する。",
      "source_locator": "ICPHM Abstract",
      "note_type": "Method",
      "selection_reason": "Representative definition, methodological family, benchmark constraint or uncertainty in approved prognostics scope",
      "provenance": {
        "source_id": "SRC-000189",
        "evidence_note": {

    {
      "evidence_id": "E0001",
      "content": "Jardineら（2006）はCBMをdata acquisition、processing、maintenance decision-makingに分け、diagnosticsを現在の故障の検知・分離・同定、prognosticsを将来の故障の予測と区別する。",
      "source_locator": "Review: Introduction and Abstract",
      "note_type": "Definition",
      "selection_reason": "Representative definition, methodological family, benchmark constraint or uncertainty in approved prognostics scope",
      "provenance": {
        "source_id": "SRC-000184",

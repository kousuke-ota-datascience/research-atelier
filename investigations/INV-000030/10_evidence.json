  "evidence_items": [
    {
      "evidence_id": "E0001",
      "content": "江戸時代の「吉田大橋」は現在の「とよばし」の位置にあり、現在の「吉田大橋」はそのやや上流に新たに架けられた。国道1号の通過に伴い物流の中心も旧吉田大橋から現在の吉田大橋へ移った。",
      "source_locator": "「新旧とよばし」節",
      "selection_reason": "橋名・橋位置・物流中心の再配置が、豊橋の具体的な名称継承と位置関係に依存する候補か比較するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-0143",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be3981209195c33472d7f78b",
          "title": "EV-000251"
        }
      }
    },
    {
      "evidence_id": "E0002",
      "content": "二川宿成立以前、二川村・大岩村は本郷から元屋敷へ移転した記録があり、正保元年（1644）には両村が現在地へ移転して一続きの宿場町となった。",
      "source_locator": "「二川村・大岩村の移転と二川宿の成立」",
      "selection_reason": "二川・大岩の複数段階の移転と宿場形成という履歴連鎖の地域依存性を比較するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-0144",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be3981f189c7c1ffe4506da4",
          "title": "EV-000252"
        }
      }
    },
    {
      "evidence_id": "E0003",
      "content": "慶応3年（1867）7月、三河国渥美郡牟呂村（現豊橋市）で始まったとされる「ええじゃないか」は、東海道を媒体として東西へ、伊那・別所街道を経て信濃国へ伝播した。",
      "source_locator": "幕末のええじゃないか説明",
      "selection_reason": "牟呂村起点説と具体的街道ネットワークの組合せが、豊橋との結び付きの強さをどの程度生むか比較するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-0145",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be3981078346c4169c4d680a",
          "title": "EV-000253"
        }
      }
    },
    {
      "evidence_id": "E0004",
      "content": "1893年に神野金之助が毛利新田を購入し、人造石工法を用いた築堤で新田開発を進めた。牟呂用水は新城市一鍬田から神野新田まで約23kmを引水する。一方、同一資料内で完成年の記載が一致せず、「神野新田と牟呂用水」では1899年完成、「世界かんがい施設遺産：松原用水・牟呂用水」では1888年完成とされるため、完成年はこの資料だけでは確定できない。",
      "source_locator": "「神野新田と牟呂用水」／「世界かんがい施設遺産：松原用水・牟呂用水」",
      "selection_reason": "神野新田と牟呂用水の固有名・造成史・長距離水利接続の組合せが地域固有性をどの程度持つか比較するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-0146",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be3981a8b162e1eaa28da838",
          "title": "EV-000254"
        }
      }
    },
    {
      "evidence_id": "E0005",
      "content": "牛川の渡しは現在も運航される渡船で、対岸に船がいるときは「呼び板」を叩いて合図すると船頭が来る仕組みである。",
      "source_locator": "「仕組み」節",
      "selection_reason": "現存する牛川の渡しと呼び板という具体的運用の地点依存性と、呼び出し方式自体の一般化可能性を比較するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-0147",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be398186a159ff2e013d7cf5",
          "title": "EV-000255"
        }
      }
    },
    {
      "evidence_id": "E0006",
      "content": "1945年の豊橋空襲後、豊橋復興土地区画整理事業により、従来の蛇行・斜行道路の一部が廃止され、格子状の新道が整備された。一方で東海道など一部の旧来道路は残す計画とされた。",
      "source_locator": "「(4) 戦後」",
      "selection_reason": "豊橋固有の戦災復興履歴と道路残存・廃止の組合せが、一般的な戦後区画整理以上の地域依存性を持つか比較するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-0148",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be398123aa97da5602e80266",
          "title": "EV-000256"
        }
      }
    },
    {
      "evidence_id": "E0007",
      "content": "豊橋鬼祭のクライマックスでは赤鬼が天狗に挑み、敗れた赤鬼が町内を走ってタンキリ飴と白い粉を撒く。タンキリ飴には厄除け・夏病み除けの伝承がある。",
      "source_locator": "豊橋鬼祭概要",
      "selection_reason": "固有の祭礼名・行為・物品・効験の連鎖が高い地域依存性を持つかを比較しつつ、既存伝承である点を別制約として保持するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-0149",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be39818cbabac78e41634c18",
          "title": "EV-000257"
        }
      }
    },
    {
      "evidence_id": "E0008",
      "content": "嵩山蛇穴は約70mの鍾乳洞で縄文時代の洞窟遺跡として国史跡に指定され、「蛇穴」という名称は大蛇が住んでいたという伝説に由来すると豊橋市は説明している。",
      "source_locator": "スポットの概要",
      "selection_reason": "史跡・自然地形・固有名・既存大蛇伝説が同一点に重なることの地域依存性を比較するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-0150",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be398123b88cdd0fbb70cb41",
          "title": "EV-000258"
        }
      }
    },
    {
      "evidence_id": "E0009",
      "content": "嵩山は本坂峠を越えて三ヶ日へ結ぶ街道（通称・姫街道）が通る交通の要衝で、古くは宿場町として栄えた。",
      "source_locator": "スポットの概要",
      "selection_reason": "嵩山宿・本坂峠・三ヶ日を結ぶ交通地理が豊橋単独ではなく広域ネットワークに依存する点を比較するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-0150",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be39810791aecd760412a822",
          "title": "EV-000259"
        }
      }
    }
  ]
}

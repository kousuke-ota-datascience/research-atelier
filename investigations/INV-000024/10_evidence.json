    },
    {
      "evidence_id": "E0005",
      "content": "propensity scoreは、観測された共変量ベクトルを条件とした特定treatmentへのassignment probabilityとして定義される。",
      "source_locator": "Abstract",
      "selection_reason": "因果推論方法論の分類対象・分類軸・taxonomy構成のいずれかを直接支えるため。",
      "note_type": "Definition",

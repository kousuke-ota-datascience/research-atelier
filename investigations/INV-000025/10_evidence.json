  "evidence_items": [
    {
      "evidence_id": "E0001",
      "content": "Pearlはcausal graphical modelを、統計情報とsubject-matter informationを統合する数学的言語として位置づけ、nonparametric causal inferenceの枠組みを提示している。",
      "source_locator": "Abstract",
      "selection_reason": "方法論的entity typeまたはroleの存在・境界を直接示すため。",
      "note_type": "Theory",
      "direct_quote": null,

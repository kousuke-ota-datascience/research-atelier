          "notion_url": "https://app.notion.com/p/3e5e5855be3981808c65efdeaa7dcb16",
          "title": "EV-000222"
        }
      }
    },
    {
      "evidence_id": "E0004",
      "content": "regression-discontinuity designは、1つ以上のrunning variableの関数としてtreatmentを受ける確率が不連続に変化するquasi-experimental designであり、その不連続性をtreatment effectのidentifying informationとして利用する。",
      "source_locator": "Abstract",
      "selection_reason": "方法論的entity typeまたはroleの存在・境界を直接示すため。",
      "note_type": "Definition",
      "direct_quote": null,

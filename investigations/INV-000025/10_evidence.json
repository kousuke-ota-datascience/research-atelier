          "notion_url": "https://app.notion.com/p/3e5e5855be3981768059e8e300b22150",
          "title": "EV-000223"
        }
      }
    },
    {
      "evidence_id": "E0005",
      "content": "CallawayとSant'Annaは、multiple time periodsとtreatment timingのばらつきがあるDifference-in-Differencesで、parallel trends assumptionの下に複数のcausal effect parameterを識別する枠組みを提示している。",
      "source_locator": "Abstract",
      "selection_reason": "方法論的entity typeまたはroleの存在・境界を直接示すため。",
      "note_type": "Method",
      "direct_quote": null,

          "notion_url": "https://app.notion.com/p/3e5e5855be3981ef9e69ea53a47d64aa",
          "title": "EV-000219"
        }
      }
    },
    {
      "evidence_id": "E0003",
      "content": "instrumental-variable estimandは、一定の仮定の下でcomplier subgroupのaverage causal effectとして解釈でき、仮定がなければ単なるintention-to-treat estimandの比に留まる。",
      "source_locator": "Abstract",
      "selection_reason": "方法論的entity typeまたはroleの存在・境界を直接示すため。",
      "note_type": "Method",
      "direct_quote": null,

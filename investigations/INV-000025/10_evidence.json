        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e5e5855be3981b6a946ea40017f2027",
          "title": "EV-000218"
        }
      }
    },
    {
      "evidence_id": "E0002",
      "content": "causal diagramは、与えられた仮定から非実験データでcausal effectが識別可能かを判定し、可能ならobserved distributionからcausal effectを表す式を導出するために使える。",
      "source_locator": "Abstract",
      "selection_reason": "方法論的entity typeまたはroleの存在・境界を直接示すため。",
      "note_type": "Method",
      "direct_quote": null,

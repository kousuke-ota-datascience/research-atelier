    },
    {
      "evidence_id": "E0006",
      "content": "TranADは多変量時系列のTransformer異常検知・診断モデルとしてself-conditioning、adversarial training、MAMLを組み込む。",
      "source_locator": "PVLDB Abstract",
      "note_type": "Method",
      "selection_reason": "Methodological taxonomy, benchmark validity or important counterevidence within the adopted scope.",

        }
      }
    },
    {
      "evidence_id": "E0005",
      "content": "Anomaly Transformerは自己注意で表現される時点間associationとassociation discrepancyを異常点の識別指標として提案する。",
      "source_locator": "ICLR Abstract",
      "note_type": "Method",
      "selection_reason": "Methodological taxonomy, benchmark validity or important counterevidence within the adopted scope.",

      }
    },
    {
      "evidence_id": "E0008",
      "content": "LiuとPaparrizos（2024）のTSB-ADは40データセット由来の1070時系列と40手法の比較を提供し、VUS-PRを推奨する。単純手法が深層手法に勝る条件があると報告した。",
      "source_locator": "NeurIPS Abstract",
      "note_type": "Result",
      "selection_reason": "Methodological taxonomy, benchmark validity or important counterevidence within the adopted scope.",
      "provenance": {

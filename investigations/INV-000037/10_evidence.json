          "title": "EV-000295"
        }
      }
    },
    {
      "evidence_id": "E0004",
      "content": "OmniAnomalyはstochastic recurrent networkとflow等で多変量時系列の通常パターンを学習し、再構成確率で異常を判定する。",
      "source_locator": "KDD Abstract",
      "note_type": "Method",
      "selection_reason": "Methodological taxonomy, benchmark validity or important counterevidence within the adopted scope.",

    },
    {
      "evidence_id": "E0016",
      "content": "MunirらのDeepAnTはCNNで時系列の次時点を予測し、実測と予測の関係からpoint/contextual anomalyを判定する二段階構造である。",
      "source_locator": "IEEE Access abstract",
      "note_type": "Method",
      "selection_reason": "Original methods covering prediction residuals, adversarial autoencoders, and self-supervised contrastive TSAD.",

          "title": "EV-000301"
        }
      }
    },
    {
      "evidence_id": "E0010",
      "content": "Lanら（2026）はqueryと周囲contextの相対的差異から異常を判定するRelative Context Discrepancyに基づくゼロショットTimeRCDを提案する。",
      "source_locator": "ICML PMLR Abstract",
      "note_type": "Method",
      "selection_reason": "Methodological taxonomy, benchmark validity or important counterevidence within the adopted scope.",
      "provenance": {

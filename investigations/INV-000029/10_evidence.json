  "evidence_items": [
    {
      "evidence_id": "E0001",
      "content": "江戸時代の「吉田大橋」は現在の「とよばし」の位置にあり、現在の「吉田大橋」はそのやや上流に新たに架けられた。国道1号の通過に伴い物流の中心も旧吉田大橋から現在の吉田大橋へ移った。",
      "source_locator": "「新旧とよばし」節",
      "selection_reason": "名称と位置が歴史的に分離・再配置された橋の事実関係を確認するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000143",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be3981209195c33472d7f78b",
          "title": "EV-000251"
        }
      }
    },
    {
      "evidence_id": "E0002",
      "content": "二川宿成立以前、二川村・大岩村は本郷から元屋敷へ移転した記録があり、正保元年（1644）には両村が現在地へ移転して一続きの宿場町となった。",
      "source_locator": "「二川村・大岩村の移転と二川宿の成立」",
      "selection_reason": "同一集落名が複数地点を経た移転史を確認するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000144",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be3981f189c7c1ffe4506da4",
          "title": "EV-000252"
        }
      }
    },
    {
      "evidence_id": "E0003",
      "content": "慶応3年（1867）7月、三河国渥美郡牟呂村（現豊橋市）で始まったとされる「ええじゃないか」は、東海道を媒体として東西へ、伊那・別所街道を経て信濃国へ伝播した。",
      "source_locator": "幕末のええじゃないか説明",
      "selection_reason": "地域発の集団行動が交通網を介して伝播した事例を確認するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000145",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be3981078346c4169c4d680a",
          "title": "EV-000253"
        }
      }
    },
    {
      "evidence_id": "E0004",
      "content": "1893年に神野金之助が毛利新田を購入し、人造石工法を用いた築堤で新田開発を進めた。牟呂用水は新城市一鍬田から神野新田まで約23kmを引水し、1899年に完成した。",
      "source_locator": "「神野新田と牟呂用水」",
      "selection_reason": "土地造成と水利インフラが地域形成を支えた事実を確認するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000146",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be3981a8b162e1eaa28da838",
          "title": "EV-000254"
        }
      }
    },
    {
      "evidence_id": "E0005",
      "content": "牛川の渡しは現在も運航される渡船で、対岸に船がいるときは「呼び板」を叩いて合図すると船頭が来る仕組みである。",
      "source_locator": "「仕組み」節",
      "selection_reason": "現存する地域交通と固有の呼び出し手順を確認するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000147",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be398186a159ff2e013d7cf5",
          "title": "EV-000255"
        }
      }
    },
    {
      "evidence_id": "E0006",
      "content": "1945年の豊橋空襲後、豊橋復興土地区画整理事業により、従来の蛇行・斜行道路の一部が廃止され、格子状の新道が整備された。一方で東海道など一部の旧来道路は残す計画とされた。",
      "source_locator": "「(4) 戦後」",
      "selection_reason": "都市道路網の消失・残存・再配置という構造を確認するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000148",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be398123aa97da5602e80266",
          "title": "EV-000256"
        }
      }
    },
    {
      "evidence_id": "E0007",
      "content": "豊橋鬼祭のクライマックスでは赤鬼が天狗に挑み、敗れた赤鬼が町内を走ってタンキリ飴と白い粉を撒く。タンキリ飴には厄除け・夏病み除けの伝承がある。",
      "source_locator": "豊橋鬼祭概要",
      "selection_reason": "地域固有の祭礼に明示的な行為・物品・効験伝承が組み込まれていることを確認するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000149",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be39818cbabac78e41634c18",
          "title": "EV-000257"
        }
      }
    },
    {
      "evidence_id": "E0008",
      "content": "嵩山蛇穴は約70mの鍾乳洞で縄文時代の洞窟遺跡として国史跡に指定され、「蛇穴」という名称は大蛇が住んでいたという伝説に由来すると豊橋市は説明している。",
      "source_locator": "スポットの概要",
      "selection_reason": "史跡・自然地形・既存伝説が重なる地点を確認するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000150",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be398123b88cdd0fbb70cb41",
          "title": "EV-000258"
        }
      }
    },
    {
      "evidence_id": "E0009",
      "content": "嵩山は本坂峠を越えて三ヶ日へ結ぶ街道（通称・姫街道）が通る交通の要衝で、古くは宿場町として栄えた。",
      "source_locator": "スポットの概要",
      "selection_reason": "境界・峠・旧街道・宿場という交通地理構造を確認するため",
      "note_type": "Claim",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000150",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/3e9e5855be39810791aecd760412a822",
          "title": "EV-000259"
        }
      }
    }
  ]
}

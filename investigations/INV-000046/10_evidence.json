          "title": "EV-000474"
        }
      }
    },
    {
      "evidence_id": "E0016",
      "content": "市内約360機場のうち67機場にIoT機器を設置したと実証参加企業が報告する。",
      "source_locator": "事業内容",
      "note_type": "Data",
      "direct_quote": null,
      "provenance": {

        }
      }
    },
    {
      "evidence_id": "E0019",
      "content": "保全周期を30%以上延長し、突発故障ゼロ、オーバーホール費抑制によるメンテナンスコスト15%以上削減と自社工場事例で報告している。",
      "source_locator": "事例本文・導入効果",

          "title": "EV-000484"
        }
      }
    },
    {
      "evidence_id": "E0026",
      "content": "逆浸透装置の振動・温度観測を用い、5分値のV-RMSをGRUで多期間予測する。異常閾値の予測到達等で事前警報し、周波数診断とCMMS作業指示につなげる。",
      "source_locator": "§2–3, Methods",
      "note_type": "Method",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000250",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/424e5855be39811e9b76e9312d996e68",
          "title": "EV-000485"
        }
      }
    },
    {

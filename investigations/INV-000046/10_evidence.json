  "evidence_items": [
    {
      "evidence_id": "E0001",
      "content": "飲料工場の逆浸透装置における予知保全事例では、振動V-RMSの5分値の多期間予測、アラーム、周波数診断、保全管理システムへの連携を実プラントへ統合したと報告する。",
      "source_locator": "Abstract",
      "note_type": "Result",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000250",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/417e5855be398156a098fb330a249801",
          "title": "EV-000388"
        }
      }
    },
    {
      "evidence_id": "E0002",
      "content": "同逆浸透設備事例は2025年の運用前後で故障なし日の割合が72.8%から84.5%へ増えたと報告するが、比較は観察的な前後比較である。",
      "source_locator": "§4.3 Operational impact",
      "note_type": "Result",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000250",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/417e5855be39819abec4f592faac2ec8",
          "title": "EV-000389"
        }
      }
    },
    {
      "evidence_id": "E0003",
      "content": "研究は3機種のデジタル印刷設備に関する100件のサービス報告を分析し、報告中の故障構成比が最も高いLEF2-200（38%）を対象に選んだ。",
      "source_locator": "pp.177–178, §2",
      "note_type": "Data",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000298",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/424e5855be3981ac9e89dada8e1015cb",
          "title": "EV-000462"
        }
      }
    },
    {
      "evidence_id": "E0004",
      "content": "データ収集には機械センサーと運転員の記録を利用し、振動、温度、電気負荷等を扱ったと著者は報告する。",
      "source_locator": "p.178, §2",
      "note_type": "Data",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000298",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/424e5855be3981e68750c1eee6d8fb31",
          "title": "EV-000463"
        }
      }
    },
    {
      "evidence_id": "E0005",
      "content": "探索的データ分析、特徴選択、決定木やロジスティック回帰等の教師あり手法、精度・適合率・再現率による評価を方法として記述している。",
      "source_locator": "pp.178–179, §2",
      "note_type": "Method",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000298",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/424e5855be3981d58e72d336d3f0a5cb",
          "title": "EV-000464"
        }
      }
    },
    {
      "evidence_id": "E0006",
      "content": "LEF2-200ではインク流量、基材反射率、周囲温度を継続監視し、臨界閾値への接近を知らせる警報により予防的清掃・交換を実施したと報告する。",
      "source_locator": "p.179, §3",
      "note_type": "Method",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000298",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/424e5855be398136a79be07b8d58048c",
          "title": "EV-000465"
        }
      }
    },
    {
      "evidence_id": "E0007",
      "content": "予知保全導入前後の比較として、総保全費28%減、計画外停止時間35%減を著者が報告する。",
      "source_locator": "p.179, §3",
      "note_type": "Result",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000298",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/424e5855be3981a2acc3c73afd197ad5",
          "title": "EV-000466"
        }
      }
    },
    {
      "evidence_id": "E0008",
      "content": "著者はヘッド詰まり40%減と稼働可能性12%改善を報告し、2か月で少なくとも5件の重大故障を防止したと述べる。",
      "source_locator": "pp.179–180, §3",
      "note_type": "Result",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000298",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/424e5855be39813b9cf3de2b2e102396",
          "title": "EV-000467"
        }
      }
    },
    {
      "evidence_id": "E0009",
      "content": "河内長野市80、今治市82、赤磐市32の計194マンホールポンプ機場が実証対象。",
      "source_locator": "資料編 §1.2 表1-1・1-2 p.3",
      "note_type": "Data",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000293",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/424e5855be39811595dddc3ae1db50f3",
          "title": "EV-000468"
        }
      }
    },
    {
      "evidence_id": "E0010",
      "content": "直近24時間のポンプ運転時間・回数を日単位で学習した正常範囲と比較し、異常をWeb・メール通知する。システムは日報・月報も扱う。",
      "source_locator": "第2章 §6 pp.13–16、図2-2",
      "note_type": "Method",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000293",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/424e5855be3981129378ee47811ab39b",
          "title": "EV-000469"
        }
      }
    },
    {
      "evidence_id": "E0011",
      "content": "点検記録・台帳から経過年数、劣化項目等による故障リスクと、排水量・稼働等による影響度を評価して更新優先順位を設定する。",
      "source_locator": "第2章 §9 pp.33–35",
      "note_type": "Method",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000293",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/424e5855be3981b5b24be318389f6e0d",
          "title": "EV-000470"
        }
      }
    },
    {
      "evidence_id": "E0012",
      "content": "実証期間の緊急出動関連11件を年換算25件とし、従来154件との比較で83%削減と評価した。",
      "source_locator": "資料編 §1.2 表1-1・1-2 p.3",
      "note_type": "Result",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000293",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/424e5855be39818caec0d90c47385d2a",
          "title": "EV-000471"
        }
      }
    },
    {
      "evidence_id": "E0013",
      "content": "異常検知の集計はTP31、FN11、FP10、TN479で、検知率73.8%、正解率約96%と報告されている。",
      "source_locator": "資料編 表1-3 p.4",
      "note_type": "Result",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000293",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/424e5855be3981b8b125df38e250894e",
          "title": "EV-000472"
        }
      }
    },
    {
      "evidence_id": "E0014",
      "content": "異常運転検知の導入による費用を、従来費と緊急出動削減等に基づいて3自治体で試算し、合計9,137万円/年から7,870万円/年、自治体別削減率の平均約15%と評価している。",
      "source_locator": "第2章 表2-6 p.50",
      "note_type": "Result",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000293",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/424e5855be398177b084ca3eb8bb769c",
          "title": "EV-000473"
        }
      }
    },
    {
      "evidence_id": "E0015",
      "content": "富山市の実証は維持管理情報とIoTデータのクラウド蓄積、AIによる異常検知・劣化予測を組み合わせ、ライフサイクルコスト低減を目指す。",
      "source_locator": "事業内容",
      "note_type": "Method",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000295",
        "evidence_note": {

        }
      }
    },
    {
      "evidence_id": "E0018",
      "content": "振動を常時監視して特徴量をリアルタイム取得し、熟練者の知見を用いてセンサー位置や閾値を検討したと報告する。",
      "source_locator": "事例本文",
      "note_type": "Method",

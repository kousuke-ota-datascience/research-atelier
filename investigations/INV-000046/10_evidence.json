        }
      }
    },
    {
      "evidence_id": "E0024",
      "content": "連続する3回の軸受記録から閾値到達前の傾向を検出し、55日目の警報から軸受交換を計画したとベンダーが報告する。",
      "source_locator": "Case study, early detection example",
      "note_type": "Method",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000299",
        "evidence_note": {
          "notion_url": "https://app.notion.com/p/424e5855be398197a965e28dbc66557c",
          "title": "EV-000483"
        }
      }
    },
    {
      "evidence_id": "E0025",
      "content": "年間保全関連支出を約50.4万ドルから28.6万ドルに減らした（43%減）とベンダーが報告する。緊急部品割増、時間外対応労働、バッチ損失の削減を要因として挙げる。",
      "source_locator": "Case study, maintenance cost results",
      "note_type": "Result",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000299",
        "evidence_note": {

    {
      "evidence_id": "E0022",
      "content": "メンテナンスコスト40%削減を技術提供企業が報告する。",
      "source_locator": "導入事例本文",
      "note_type": "Result",
      "direct_quote": null,
      "provenance": {
        "source_id": "SRC-000297",

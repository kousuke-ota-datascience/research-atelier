{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "00_sources.schema.json",
  "title": "Urban Legend Sources and Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entry_id", "sources", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "entry_id": {"type": "string", "pattern": "^[0-9]{4}$"},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "title", "locator", "relation_to_primary", "evidence_role"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"},
        "source_type": {
          "type": "string",
          "enum": [
            "primary_or_contemporary",
            "mirror_reprint_or_restoration",
            "reliable_secondary_or_research",
            "later_summary_or_commentary",
            "other"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "accessed_at": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "null"}
          ]
        },
        "relation_to_primary": {
          "type": "string",
          "enum": ["primary", "direct_derivative", "indirect_derivative", "unknown", "not_applicable"]
        },
        "evidence_role": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["C", "H", "X", "A"]}
        },
        "url": {"type": "string", "format": "uri"},
        "bibliographic_info": {"type": "string"},
        "archive_info": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_id", "locator", "content", "representation"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"},
        "source_id": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"},
        "locator": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "representation": {"type": "string", "enum": ["quote", "paraphrase"]},
        "uncertainty": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}

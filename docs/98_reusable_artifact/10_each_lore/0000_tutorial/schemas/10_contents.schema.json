{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "10_contents.schema.json",
  "title": "Urban Legend Reconstructed Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entry_id",
    "lore_name",
    "summary",
    "content_units",
    "variants",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "lore_name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "content_units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contentUnit"
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainty"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrative",
        "structure",
        "coverage_refs"
      ],
      "properties": {
        "narrative": {
          "type": "string",
          "minLength": 1
        },
        "structure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary_actors",
            "affected_targets",
            "entry_trigger",
            "causal_agent",
            "mechanism",
            "state_transition",
            "temporal_structure",
            "rules_and_taboos",
            "avoidance_control",
            "terminal_state",
            "uncertainties",
            "variant_boundaries"
          ],
          "properties": {
            "primary_actors": {
              "$ref": "#/$defs/structuredValue"
            },
            "affected_targets": {
              "$ref": "#/$defs/structuredValue"
            },
            "entry_trigger": {
              "$ref": "#/$defs/structuredValue"
            },
            "causal_agent": {
              "$ref": "#/$defs/structuredValue"
            },
            "mechanism": {
              "$ref": "#/$defs/structuredValue"
            },
            "state_transition": {
              "$ref": "#/$defs/structuredValue"
            },
            "temporal_structure": {
              "$ref": "#/$defs/structuredValue"
            },
            "rules_and_taboos": {
              "$ref": "#/$defs/structuredValue"
            },
            "avoidance_control": {
              "$ref": "#/$defs/structuredValue"
            },
            "terminal_state": {
              "$ref": "#/$defs/structuredValue"
            },
            "uncertainties": {
              "$ref": "#/$defs/structuredValue"
            },
            "variant_boundaries": {
              "$ref": "#/$defs/structuredValue"
            }
          }
        },
        "coverage_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CNT-[0-9]{3,}$"
          }
        }
      }
    },
    "structuredValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "contentUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_id",
        "type",
        "text",
        "evidence_refs"
      ],
      "properties": {
        "content_id": {
          "type": "string",
          "pattern": "^CNT-[0-9]{3,}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "event",
            "claim",
            "rule",
            "action",
            "outcome",
            "actor",
            "location",
            "object",
            "condition",
            "other"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVD-[0-9]{3,}$"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "kind",
        "description",
        "content_refs",
        "evidence_refs"
      ],
      "properties": {
        "variant_id": {
          "type": "string",
          "pattern": "^VAR-[0-9]{3,}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "initial",
            "later",
            "major",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "attestation": {
          "type": "string"
        },
        "content_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CNT-[0-9]{3,}$"
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVD-[0-9]{3,}$"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVD-[0-9]{3,}$"
          }
        },
        "content_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CNT-[0-9]{3,}$"
          }
        }
      }
    }
  }
}

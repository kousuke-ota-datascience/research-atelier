{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "任意の意味論的正規化overlay（非正本）",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "case_assessments_semantic_overlay"
    },
    "investigation_id": {
      "type": "string",
      "pattern": "^INV-[0-9]{6}$"
    },
    "rq_id": {
      "type": "string",
      "pattern": "^RQ-[0-9]{6}$"
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^C[0-9]{2,}$"
          },
          "factor_id": {
            "type": "string",
            "pattern": "^D[0-9]{2}(\\.[0-9]+)?$"
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "value_text": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_excerpt": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "field",
                "value_text",
                "unit",
                "source_excerpt"
              ],
              "additionalProperties": false
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "case_id",
          "factor_id",
          "attributes",
          "limitations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "investigation_id",
    "rq_id",
    "baseline_sha256",
    "entries"
  ],
  "additionalProperties": false
}

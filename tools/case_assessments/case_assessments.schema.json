{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case assessments derived contract v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "case_assessments"
    },
    "authority": {
      "const": "derived"
    },
    "investigation_id": {
      "type": "string",
      "pattern": "^INV-[0-9]{6}$"
    },
    "rq_id": {
      "type": "string",
      "pattern": "^RQ-[0-9]{6}$"
    },
    "derived_from": {
      "type": "object",
      "properties": {
        "analysis_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "analysis_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_blob_shas": {
          "type": "object",
          "properties": {
            "00_context": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "10_evidence": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "20_synthesis": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "30_analysis": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "00_context",
            "10_evidence",
            "20_synthesis",
            "30_analysis"
          ],
          "additionalProperties": false
        },
        "review_seq": {
          "type": "integer",
          "minimum": 1
        },
        "review_target_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "review_manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "review_manifest_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "projection_log_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "analysis_commit_sha",
        "analysis_blob_sha",
        "artifact_blob_shas",
        "review_seq",
        "review_target_commit_sha",
        "review_manifest_path",
        "review_manifest_blob_sha",
        "projection_log_blob_sha"
      ],
      "additionalProperties": false
    },
    "factor_framework": {
      "type": "object",
      "properties": {
        "rq_id": {
          "type": "string",
          "pattern": "^RQ-[0-9]{6}$"
        },
        "investigation_id": {
          "type": "string",
          "pattern": "^INV-[0-9]{6}$"
        },
        "analysis_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "analysis_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "factor_count": {
          "type": "integer",
          "minimum": 1
        },
        "factor_definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "factor_id": {
                "type": "string",
                "pattern": "^D[0-9]{2}\\.[0-9]+$"
              },
              "framework_class": {
                "enum": [
                  "C",
                  "A",
                  "P",
                  "U"
                ]
              },
              "definition_text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "factor_id",
              "framework_class",
              "definition_text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "rq_id",
        "investigation_id",
        "analysis_commit_sha",
        "analysis_blob_sha",
        "factor_count",
        "factor_definitions"
      ],
      "additionalProperties": false
    },
    "criteria_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^R[1-4]$"
          },
          "definition_text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "criterion_id",
          "definition_text"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "factor_assessment_count": {
          "type": "integer",
          "minimum": 1
        },
        "criterion_assessment_count": {
          "type": "integer",
          "minimum": 1
        },
        "eligibility_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "factor_status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "criterion_status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "case_count",
        "factor_assessment_count",
        "criterion_assessment_count",
        "eligibility_counts",
        "factor_status_counts",
        "criterion_status_counts"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^C[0-9]{2,}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SRC-[0-9]{6}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "eligibility": {
            "enum": [
              "full_match",
              "near_match",
              "excluded"
            ]
          },
          "canonical_eligibility": {
            "enum": [
              "完全適合事例",
              "近接事例",
              "除外事例"
            ]
          },
          "exclusion_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "knowledge_unit_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^K[0-9]{4}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "canonical_header": {
            "type": "string",
            "minLength": 1
          },
          "canonical_scope_line": {
            "type": "string",
            "minLength": 1
          },
          "analysis_line": {
            "type": "integer",
            "minimum": 1
          },
          "criteria_assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "criterion_id": {
                  "type": "string",
                  "pattern": "^R[1-4]$"
                },
                "status": {
                  "enum": [
                    "confirmed",
                    "unconfirmed",
                    "not_met"
                  ]
                },
                "canonical_status": {
                  "enum": [
                    "確認済",
                    "未確認",
                    "不適合"
                  ]
                },
                "assessment_text": {
                  "type": "string",
                  "minLength": 1
                },
                "reference_role": {
                  "enum": [
                    "basis",
                    "confirmation_scope"
                  ]
                },
                "canonical_line": {
                  "type": "string",
                  "minLength": 1
                },
                "analysis_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "knowledge_unit_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^K[0-9]{4}$"
                  },
                  "uniqueItems": true,
                  "minItems": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^E[0-9]{4}$"
                  },
                  "uniqueItems": true,
                  "minItems": 1
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^SRC-[0-9]{6}$"
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              },
              "required": [
                "criterion_id",
                "status",
                "canonical_status",
                "assessment_text",
                "reference_role",
                "canonical_line",
                "analysis_line",
                "knowledge_unit_refs",
                "evidence_refs",
                "source_refs"
              ],
              "additionalProperties": false
            }
          },
          "factor_assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "factor_id": {
                  "type": "string",
                  "pattern": "^D[0-9]{2}\\.[0-9]+$"
                },
                "factor_label": {
                  "type": "string",
                  "minLength": 1
                },
                "canonical_status": {
                  "enum": [
                    "該当・原典報告",
                    "該当・分析上の推論",
                    "未知",
                    "非該当",
                    "サブタスク別：非該当／未知"
                  ]
                },
                "applicability": {
                  "enum": [
                    "applicable",
                    "undetermined",
                    "not_applicable",
                    "mixed"
                  ]
                },
                "epistemic_status": {
                  "enum": [
                    "reported",
                    "inference",
                    "undetermined",
                    "not_applicable",
                    "mixed"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "assessment_text": {
                  "type": "string",
                  "minLength": 1
                },
                "limitations": {
                  "type": "null"
                },
                "reference_role": {
                  "enum": [
                    "basis",
                    "confirmation_scope"
                  ]
                },
                "canonical_line": {
                  "type": "string",
                  "minLength": 1
                },
                "analysis_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "knowledge_unit_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^K[0-9]{4}$"
                  },
                  "uniqueItems": true,
                  "minItems": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^E[0-9]{4}$"
                  },
                  "uniqueItems": true,
                  "minItems": 1
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^SRC-[0-9]{6}$"
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              },
              "required": [
                "factor_id",
                "factor_label",
                "canonical_status",
                "applicability",
                "epistemic_status",
                "value",
                "assessment_text",
                "limitations",
                "reference_role",
                "canonical_line",
                "analysis_line",
                "knowledge_unit_refs",
                "evidence_refs",
                "source_refs"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "case_id",
          "name",
          "source_refs",
          "eligibility",
          "canonical_eligibility",
          "exclusion_reason",
          "knowledge_unit_scope",
          "canonical_header",
          "canonical_scope_line",
          "analysis_line",
          "criteria_assessments",
          "factor_assessments"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "authority",
    "investigation_id",
    "rq_id",
    "derived_from",
    "factor_framework",
    "criteria_definitions",
    "summary",
    "cases"
  ],
  "additionalProperties": false
}

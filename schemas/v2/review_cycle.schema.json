{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-atelier.local/schemas/v2/review_cycle.schema.json",
  "title": "Research Atelier Semantic Review Cycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "investigation_id",
    "review_seq",
    "target",
    "reviewed_at",
    "transitions",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_type": {
      "const": "semantic_review"
    },
    "investigation_id": {
      "type": "string",
      "pattern": "^(?:INV-(?!000000)[0-9]{6}|RQ-[0-9]{4}-v(?!000)[0-9]{3})$"
    },
    "review_seq": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "artifact_blob_shas"
      ],
      "properties": {
        "commit_sha": {
          "$ref": "#/$defs/sha"
        },
        "artifact_blob_shas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "00_context",
            "10_evidence",
            "20_synthesis",
            "30_analysis"
          ],
          "properties": {
            "00_context": {
              "$ref": "#/$defs/sha"
            },
            "10_evidence": {
              "$ref": "#/$defs/sha"
            },
            "20_synthesis": {
              "$ref": "#/$defs/sha"
            },
            "30_analysis": {
              "$ref": "#/$defs/sha"
            }
          }
        }
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "transitions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transition",
            "target_artifact",
            "target_blob_sha",
            "assessment",
            "findings"
          ],
          "properties": {
            "transition": {
              "const": "source_evidence_note_to_10_evidence"
            },
            "target_artifact": {
              "const": "10_evidence"
            },
            "target_blob_sha": {
              "$ref": "#/$defs/sha"
            },
            "assessment": {
              "type": "string",
              "minLength": 1
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/finding"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transition",
            "target_artifact",
            "target_blob_sha",
            "assessment",
            "findings"
          ],
          "properties": {
            "transition": {
              "const": "10_evidence_to_20_synthesis"
            },
            "target_artifact": {
              "const": "20_synthesis"
            },
            "target_blob_sha": {
              "$ref": "#/$defs/sha"
            },
            "assessment": {
              "type": "string",
              "minLength": 1
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/finding"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transition",
            "target_artifact",
            "target_blob_sha",
            "assessment",
            "findings"
          ],
          "properties": {
            "transition": {
              "const": "20_synthesis_plus_00_context_to_30_analysis"
            },
            "target_artifact": {
              "const": "30_analysis"
            },
            "target_blob_sha": {
              "$ref": "#/$defs/sha"
            },
            "assessment": {
              "type": "string",
              "minLength": 1
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/finding"
              }
            }
          }
        }
      ],
      "items": false
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FINDINGS"
      ]
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "target",
        "evidence",
        "impact",
        "repair_direction"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^F[0-9]{3}$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "Minor",
            "Moderate",
            "Major"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "repair_direction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "affected_layer",
            "instruction"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "same_investigation",
                "new_investigation"
              ]
            },
            "affected_layer": {
              "type": "string",
              "enum": [
                "00_context",
                "10_evidence",
                "20_synthesis",
                "30_analysis"
              ]
            },
            "instruction": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
